# Copy to .env.local for local development, or set these in Render.

# Canonical origin, used for metadata, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://claudelazystarter.theatom.lk

# Automation driver: "simulated" (default), "claude-code" (recommended, real),
# or "playwright" (legacy real browser driver).
LAZY_DRIVER=simulated

# Where the file store keeps state. On Render, point at the mounted disk.
# LAZY_DATA_DIR=/var/data

# Claude Code driver options (only used when LAZY_DRIVER=claude-code).
# CLAUDE_CODE_OAUTH_TOKEN=   # from: claude setup-token
# LAZY_CLAUDE_MODEL=haiku
# LAZY_CLAUDE_BIN=claude
# LAZY_CLAUDE_TIMEOUT_MS=120000

# Playwright driver options (only used when LAZY_DRIVER=playwright).
LAZY_HEADLESS=true
# LAZY_CLAUDE_URL=https://claude.ai
# LAZY_NAV_TIMEOUT_MS=45000
# LAZY_COMPOSER_SELECTOR=
# LAZY_SEND_SELECTOR=

# Token that guards the session upload endpoint. Use a long random value.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Simulated driver diagnostics.
# LAZY_SIM_OUTCOME=success
# LAZY_SIM_LATENCY_MS=800
